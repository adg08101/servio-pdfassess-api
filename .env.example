NODE_ENV=development
PORT=3000
HOST=0.0.0.0
MONGODB_URI=mongodb://localhost:27017/pdfassess
COOKIE_SECRET=change-me-very-long-secret
SESSION_TTL_MINUTES=120
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=1
MAX_IMPORT_FILE_SIZE_MB=25
MAX_IMPORT_PAGE_COUNT=200
GOOGLE_DRIVE_API_KEY=
OBJECT_STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=./.local-storage
CORS_ORIGINS=http://localhost:5173
SAMPLE_PDF_PATH=./samples/pdfs/level2wb.pdf
ANALYSIS_MAX_PAGES_PER_JOB=5
ANALYSIS_MAX_FILE_SIZE_MB=200
ANALYSIS_DEFAULT_DPI=144
ANALYSIS_MAX_DPI=220
ANALYSIS_PREVIEW_DIR=./.local-storage/analysis-previews
OCR_ADAPTER=tesseract-cli
OCR_TESSERACT_BIN=tesseract
OCR_LANGUAGE=eng
